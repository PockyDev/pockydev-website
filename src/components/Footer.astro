---
import { site } from '../data/site';
import { type Lang, route, ui } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <strong>PockyDev</strong>
      <p>{t.footerClaim}<br />{t.footerNoTracking}</p>
    </div>
    <nav aria-label={t.navLegal}>
      <a href={route('imprint', lang)}>{t.imprint}</a>
      <a href={route('privacy', lang)}>{t.privacy}</a>
      <a href={site.links.github} rel="me">GitHub</a>
    </nav>
  </div>
  <div class="container copy">© {year} PockyDev</div>
</footer>

<style>
  .site-footer { margin-top: 96px; padding: 40px 0 32px; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.95rem; }
  .cols { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; }
  .cols p { margin: 0.3em 0 0; }
  strong { color: var(--text); }
  nav { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-start; }
  nav a { color: var(--muted); }
  .copy { margin-top: 24px; font-size: 0.85rem; }
</style>
