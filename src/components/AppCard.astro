---
import { type App, playStoreUrl } from '../data/apps';
import { type Lang, route, ui } from '../data/i18n';
interface Props { app: App; lang: Lang }
const { app, lang } = Astro.props;
const t = ui[lang];
const page = route(`app:${app.slug}`, lang);
---
<article class:list={['card', app.theme && `theme-${app.theme}`]}>
  <div class="card-head">
    <img src={app.icon} alt="" width="72" height="72" loading="lazy" />
    <div>
      <h3><a href={page}>{app.name}</a></h3>
      <p class="tagline">{app.tagline}</p>
    </div>
  </div>
  <p>{app.teaser}</p>
  <ul class="chips">{app.facts.map((f) => <li>{f}</li>)}</ul>
  <div class="card-actions">
    <a class="btn" href={playStoreUrl(app, lang, 'home')}>{t.getOnPlay}</a>
    <a class="btn secondary" href={page}>{t.learnMore}</a>
  </div>
</article>

<style>
  /* Apps with their own look get a hint of it on the card: their accent colour on top */
  .theme-phonea { border-top: 4px solid #094a74; }
  .theme-phonea .chips li { background: color-mix(in srgb, #88baea 30%, transparent); }
  @media (prefers-color-scheme: dark) {
    .theme-phonea { border-top-color: #88baea; }
  }
</style>
