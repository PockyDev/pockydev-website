---
import { type Lang, type RouteKey, route, ui } from '../data/i18n';
interface Props { lang: Lang; routeKey?: RouteKey }
const { lang, routeKey } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'de' ? 'en' : 'de';
const path = Astro.url.pathname;
const nav = [
  { href: `${route('home', lang)}#apps`, label: t.navApps },
  { href: route('about', lang), label: t.navAbout },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={route('home', lang)}>
      Pocky<span class="dev">Dev</span>
    </a>
    <nav aria-label={t.navMain}>
      {nav.map((item) => (
        <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="lang" href={route(routeKey ?? 'home', other)} hreflang={other} lang={other} title={t.switchTitle}>{t.switchLabel}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 5;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 12px; }
  .brand { color: var(--text); text-decoration: none; font-weight: 800; font-size: 1.4rem; letter-spacing: -0.02em; }
  .brand .dev { color: var(--brand-dev); }
  nav { display: flex; gap: 20px; align-items: center; }
  nav a { color: var(--text); text-decoration: none; font-weight: 500; }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent); }
  .lang { font-size: 0.85rem; padding: 0.2em 0.7em; border: 1.5px solid var(--border); border-radius: 999px; }
  @media (max-width: 400px) { nav { gap: 12px; } .brand { font-size: 1.2rem; } }
</style>
