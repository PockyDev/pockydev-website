---
import { url } from '../data/url';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const profiles = [
  { label: 'GitHub', href: site.links.github },
  { label: 'LinkedIn', href: site.links.linkedin },
  { label: 'XING', href: site.links.xing },
].filter((p) => !p.href.startsWith('TODO'));
---
<Base title="Über mich" routeKey="about" description="Tim, Softwareentwickler aus Reinfeld bei Lübeck: seit 2014 professionell in der Softwareentwicklung, heute Führungskraft, nebenbei Android-Apps unter dem Namen PockyDev.">
  <section class="container prose about">
    <img class="portrait" src={url("/images/tim.webp")} alt={site.owner} width="160" height="160" />
    <h1>Über mich</h1>
    <p>Ich bin Tim, Softwareentwickler aus Reinfeld bei Lübeck. Unter dem Namen PockyDev entwickle ich meine eigenen Apps und bleibe so selbst am Code.</p>
    <p>Nach meinem Informatik-Studium an der TH Lübeck entwickle ich seit 2014 professionell Software, erst mit Java, ab 2018 als Android-Entwickler. Inzwischen arbeite ich im Job als Führungskraft in der Entwicklung, mit Teams, Planung und vielen Meetings.</p>
    <p>Abends und am Wochenende baue ich dafür umso lieber eigene Android-Apps mit Kotlin und Jetpack Compose, von der Idee bis zum Release im Play Store. KI-Werkzeuge wie Claude Code sind dabei fester Teil meines Workflows, von der Planung über den Code bis zu den Tests.</p>
    <h2>Profile</h2>
    <ul class="profiles">
      {profiles.map((p) => <li><a class="btn secondary" href={p.href} rel="me">{p.label}</a></li>)}
    </ul>
    <h2>Kontakt</h2>
    <p>Feedback, Fehler in den Daten oder Ideen? Schreib mir an <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
  </section>
</Base>

<style>
  .about { padding-top: 56px; }
  .portrait { border-radius: 50%; margin-bottom: 20px; box-shadow: 0 0 0 4px var(--bg), 0 0 0 7px var(--corgi); }
  .profiles { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
</style>
