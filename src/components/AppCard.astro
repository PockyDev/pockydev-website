---
import { url } from '../data/url';
import { type App, playStoreUrl } from '../data/apps';
interface Props { app: App }
const { app } = Astro.props;
---
<article class="card">
  <div class="head">
    <img src={app.icon} alt="" width="72" height="72" loading="lazy" />
    <div>
      <h3><a href={url(`/apps/${app.slug}/`)}>{app.name}</a></h3>
      <p class="tagline">{app.tagline}</p>
    </div>
  </div>
  <p>{app.teaser}</p>
  <ul class="chips">{app.facts.map((f) => <li>{f}</li>)}</ul>
  <div class="actions">
    <a class="btn" href={playStoreUrl(app)}>Bei Google Play</a>
    <a class="btn secondary" href={url(`/apps/${app.slug}/`)}>Mehr erfahren</a>
  </div>
</article>

<style>
  .card {
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 24px; display: flex; flex-direction: column; gap: 14px;
  }
  .head { display: flex; gap: 16px; align-items: center; }
  .head img { border-radius: 16px; flex: none; }
  h3 { margin: 0; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .tagline { margin: 2px 0 0; color: var(--muted); }
  p { margin: 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; padding-top: 6px; }
</style>
